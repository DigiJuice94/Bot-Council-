# Primary real market discovery/enrichment
BIRDEYE_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=
JUPITER_API_KEY=
GOPLUS_API_TOKEN=

# Provider waterfall (all optional; bot falls back automatically)
MORALIS_API_KEY=
BITQUERY_API_TOKEN=
ZEROEX_API_KEY=
SOLANA_WALLET_ADDRESS=
SOLANA_TAKER_ADDRESS=

# Persistence (strongly recommended on Railway)
REDIS_URL=

# Real-data paper research account
PAPER_STARTING_CASH_USD=1000

# Early Runner Lab (PAPER only). Cash is the real exposure boundary.
# Losses are deliberately allowed because the Filing Cabinet learns from them.
PAPER_MAX_DAILY_LOSS_PCT=100
PAPER_MAX_OPEN_POSITIONS=20
PAPER_MAX_TOTAL_EXPOSURE_PCT=100
PAPER_MAX_CHAIN_EXPOSURE_PCT=100
PAPER_EARLY_RUNNER_MAX_OPEN_POSITIONS=20

# Keep research running after a paper bankroll is exhausted.
# Refill only occurs when there are no open positions and equity is <= threshold.
PAPER_AUTO_REFILL_ON_ZERO=false
PAPER_AUTO_REFILL_THRESHOLD_USD=50

# WATCH opportunities are active paper-training reps in the early-runner lane.
PAPER_EXPLORATION_MODE=true
PAPER_SHADOW_REVIEW_MINUTES=15
PAPER_FAIL_CLOSED_UNKNOWN=false

# Runner Genome research labels / early-entry definition
RESEARCH_RUNNER_TARGET_MC=300000
RESEARCH_DUMPER_DROP_PCT=60
RESEARCH_FRESH_ENTRY_MAX_MC=50000
RESEARCH_FRESH_ENTRY_MAX_AGE_MINUTES=1440
# A fresh-coin win must close net-positive AND reach at least this return.
RESEARCH_FRESH_WIN_MIN_RETURN_PCT=10

# CODE DECIPHERED graduation gates
RESEARCH_REQUIRED_CASES=2000
RESEARCH_REQUIRED_LABELED_CASES=300
RESEARCH_REQUIRED_FRESH_WINS=100
RESEARCH_REQUIRED_OOS_ACCURACY_PCT=65
RESEARCH_REQUIRED_PROFIT_FACTOR=1.3
RESEARCH_MAX_ALLOWED_DRAWDOWN_PCT=35
RESEARCH_REQUIRED_PROVIDER_COVERAGE_PCT=75
RESEARCH_REQUIRED_CONFIRMED_TELLS=3

# Automatic live unlock.
# The dashboard itself never stores/signs with private keys. At 100% Code Deciphered,
# approved Council BUYs can be forwarded to a dedicated live executor service.
AUTO_ENABLE_LIVE_ON_CODE_DECIPHERED=true
LIVE_EXECUTOR_URL=
LIVE_EXECUTOR_TOKEN=
LIVE_MAX_NOTIONAL_USD=25

# One chain is polled each tick; default 2000ms (~14s per seven-chain rotation)
WAR_ROOM_SCAN_INTERVAL_MS=2000
WAR_ROOM_MARKET_DATA_MODE=live

# Optional custom adapter instead of direct providers
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=

# V2.25 Early Runner Core — paper research only
# $50 is the minimum entry, not a fixed position size.
PAPER_TRAINING_MIN_BUY_USD=50
PAPER_TRAINING_MAX_BUY_USD=150
PAPER_WATCH_MAX_BUY_USD=100
PAPER_EARLY_RUNNER_BUY_SCORE=62
PAPER_EARLY_RUNNER_WATCH_SCORE=42
PAPER_EARLY_RUNNER_MAX_DUMPER_RISK=80
PAPER_EARLY_RUNNER_DISCOVERY_MIN_LIQUIDITY_USD=1000
PAPER_EARLY_RUNNER_ABSOLUTE_MIN_LIQUIDITY_USD=1000
PAPER_EARLY_RUNNER_MAX_SLIPPAGE_BPS=600
PAPER_WINNER_MAX_ADD_USD=100


# V2.27 — INDEPENDENT LOCAL COUNCIL
# No OpenAI/ChatGPT key is used or required.
COUNCIL_ENTITY_MODE=independent-local
COUNCIL_DEBATE_ROUND=true

# V2.26.2 PAPER RUNNER LAB
# Portfolio kill switches are intentionally disabled in PAPER mode.
# Losses, drawdowns, open-position count and portfolio/chain exposure do NOT stop research.
# Real paper-wallet cash, hard token safety and executable-route checks still apply.

# V2.28 Exit Strategist
PAPER_PROFIT_TAKE_MAX_SLIPPAGE_BPS=2000
# Minimum fresh-runner starter remains $50 unless you intentionally change it.
PAPER_TRAINING_MIN_BUY_USD=50

# V2.29 Trajectory Observer
# Background-only sequence watcher. Does not vote or place trades.
TRAJECTORY_OBSERVER_REVIEW_MS=30000

# V3.6.2 Audit Watch — observational only.
# Audits open PAPER positions for confirmed locked/unsellable capital.
# UNKNOWN/unsupported coverage never blocks buys, sells, chains, or Council decisions.
PAPER_SELL_AUDIT_REFRESH_MS=30000
# Isolated Council tournament (defaults shown)
TOURNAMENT_QUALIFIER_HOURS=24
TOURNAMENT_FINAL_HOURS=24
TOURNAMENT_MAX_OPEN_POSITIONS=12
TOURNAMENT_PAPER_FEE_BPS=25
# Bounded provider scan lanes. Valid range: 1-3.
WAR_ROOM_SCAN_WORKERS=3
